    {
      "id": 9,
      "title": "Where the client waits (p95)",
      "description": "blocked = connection-slot wait; connecting = TCP; waiting = TTFB. Percentiles of phases are not additive. Histograms aggregate per selected run, not a max of precomputed p95 gauges.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (vmrange,profile,testid)(rate(k6_http_req_blocked_seconds_bucket{job=\"k6\",service=\"dumbwaiter\",profile=~\"$profile\",testid=~\"$testid\",scenario=\"traffic\"}[$__rate_interval])))",
          "legendFormat": "blocked {{profile}} {{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (vmrange,profile,testid)(rate(k6_http_req_connecting_seconds_bucket{job=\"k6\",service=\"dumbwaiter\",profile=~\"$profile\",testid=~\"$testid\",scenario=\"traffic\"}[$__rate_interval])))",
          "legendFormat": "connecting {{profile}} {{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (vmrange,profile,testid)(rate(k6_http_req_sending_seconds_bucket{job=\"k6\",service=\"dumbwaiter\",profile=~\"$profile\",testid=~\"$testid\",scenario=\"traffic\"}[$__rate_interval])))",
          "legendFormat": "sending {{profile}} {{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (vmrange,profile,testid)(rate(k6_http_req_waiting_seconds_bucket{job=\"k6\",service=\"dumbwaiter\",profile=~\"$profile\",testid=~\"$testid\",scenario=\"traffic\"}[$__rate_interval])))",
          "legendFormat": "waiting {{profile}} {{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.95, sum by (vmrange,profile,testid)(rate(k6_http_req_receiving_seconds_bucket{job=\"k6\",service=\"dumbwaiter\",profile=~\"$profile\",testid=~\"$testid\",scenario=\"traffic\"}[$__rate_interval])))",
          "legendFormat": "receiving {{profile}} {{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        }
      ],
