    },
    {
      "id": 7,
      "title": "Age of last target sample",
      "description": "Normally near the 5s push interval plus ingestion delay. No stale-marker batch: native histograms with stale markers are incompatible with the pinned VM receiver. After stop, use freshness and container exit status; old series expire naturally.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (profile,testid)(timestamp(k6_load_target_rps{job=\"k6\",service=\"dumbwaiter\",profile=~\"$profile\",testid=~\"$testid\"}))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
