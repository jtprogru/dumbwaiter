    {
      "id": 10,
      "title": "Errors: client expectations vs server HTTP status",
      "description": "The fixture intentionally returns about 1% 502, counted as server 5xx but expected by k6. Client curve includes network errors. Separate body validation is shown in the cumulative unexpected-response panel.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (profile,testid)(rate(k6_http_reqs_total{job=\"k6\",service=\"dumbwaiter\",profile=~\"$profile\",testid=~\"$testid\",scenario=\"traffic\",expected_response=\"false\"}[$__rate_interval]))) or (0 * sum by (profile,testid)(rate(k6_http_reqs_total{job=\"k6\",service=\"dumbwaiter\",profile=~\"$profile\",testid=~\"$testid\",scenario=\"traffic\"}[$__rate_interval])))) / (sum by (profile,testid)(rate(k6_http_reqs_total{job=\"k6\",service=\"dumbwaiter\",profile=~\"$profile\",testid=~\"$testid\",scenario=\"traffic\"}[$__rate_interval])) > 0)",
          "legendFormat": "unexpected k6 {{profile}} {{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "((sum(rate(dumbwaiter_http_requests_total{job=\"dumbwaiter\",host=\"loadtest.local\",code=~\"5..\"}[$__rate_interval]))) or (0 * sum(rate(dumbwaiter_http_requests_total{job=\"dumbwaiter\",host=\"loadtest.local\"}[$__rate_interval])))) / (sum(rate(dumbwaiter_http_requests_total{job=\"dumbwaiter\",host=\"loadtest.local\"}[$__rate_interval])) > 0)",
          "legendFormat": "server 5xx: ALL load runs",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
