    {
      "id": 13,
      "title": "Server requests in flight (all traffic)",
      "description": "Not admission-slot occupancy; includes every host/listener. Correlate with latency and rejections.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dumbwaiter_http_requests_in_flight{job=\"dumbwaiter\"}",
