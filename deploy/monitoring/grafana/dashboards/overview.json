    {
      "id": 4,
      "title": "HTTP 5xx ratio",
      "description": "Not download success: a committed 200 can abort. Idle and missing data remain No data; no preexisting error series is treated as zero only alongside a request total.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (host)(rate(dumbwaiter_http_requests_total{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\",code=~\"5..\"}[$__rate_interval]))) or (0 * sum by (host)(rate(dumbwaiter_http_requests_total{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\"}[$__rate_interval])))) / (sum by (host)(rate(dumbwaiter_http_requests_total{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Full response latency",
      "description": "Includes body and slow clients, all statuses/outcomes. Aggregate buckets before quantiles. Highest finite bucket is 30s; a clipped p99 is not a measured tail bound.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le)(rate(dumbwaiter_http_request_duration_seconds_bucket{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le)(rate(dumbwaiter_http_request_duration_seconds_bucket{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le)(rate(dumbwaiter_http_request_duration_seconds_bucket{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Locally failed transfers (excluding cancellations)",
      "description": "Separate from 5xx; do NOT add the two ratios (overlapping requests). Cancellations are shown below, not classified as server failures.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (host)(rate(dumbwaiter_http_response_outcomes_total{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\",outcome=~\"aborted|write_error|panic\"}[$__rate_interval]))) or (0 * sum by (host)(rate(dumbwaiter_http_response_outcomes_total{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\"}[$__rate_interval])))) / (sum by (host)(rate(dumbwaiter_http_response_outcomes_total{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
