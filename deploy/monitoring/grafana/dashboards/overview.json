    {
      "id": 14,
      "title": "Responses beyond histogram's finite tail",
      "description": "Fraction of full responses >30s. Useful when p99 sticks to 30s.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(dumbwaiter_http_request_duration_seconds_count{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\"}[$__rate_interval])) - sum(rate(dumbwaiter_http_request_duration_seconds_bucket{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\",le=\"30\"}[$__rate_interval]))) / (sum(rate(dumbwaiter_http_request_duration_seconds_count{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\"}[$__rate_interval])) > 0)",
