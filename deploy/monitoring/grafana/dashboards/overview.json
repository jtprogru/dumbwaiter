      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host,code)(rate(dumbwaiter_http_requests_total{job=\"dumbwaiter\",instance=~\"$instance\",host=~\"$host\",listener=~\"$listener\"}[$__rate_interval]))",
