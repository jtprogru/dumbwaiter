{
  "uid": "dumbwaiter-overview",
  "title": "dumbwaiter · Overview / RED",
  "description": "Start with scrape health and the known-object probe. HTTP status and transfer outcomes are independent; this is not an SLO dashboard.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "dumbwaiter"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "title": "dumbwaiter",
      "type": "dashboards",
      "tags": [
        "dumbwaiter"
      ],
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=\"dumbwaiter\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"dumbwaiter\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(dumbwaiter_http_requests_total{job=\"dumbwaiter\",instance=~\"$instance\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(dumbwaiter_http_requests_total{job=\"dumbwaiter\",instance=~\"$instance\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "listener",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(dumbwaiter_http_requests_total{job=\"dumbwaiter\",instance=~\"$instance\"}, listener)",
          "refId": "listener"
        },
        "definition": "label_values(dumbwaiter_http_requests_total{job=\"dumbwaiter\",instance=~\"$instance\"}, listener)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Application scrape health (1 = up)",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"dumbwaiter\",instance=~\"$instance\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "instant": true,
          "format": "time_series"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
