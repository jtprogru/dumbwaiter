{
  "uid": "dumbwaiter-logs",
  "title": "dumbwaiter · Logs",
  "description": "Structured access and application logs. Expand log details for host/path/status/outcome/duration_ms. Raw paths and remote IPs stay log fields, never metric labels.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "dumbwaiter"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "title": "dumbwaiter",
      "type": "dashboards",
      "tags": [
        "dumbwaiter"
      ],
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Log rate by level",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"dumbwaiter\",environment=\"local\"} | stats by (level) rate()",
          "legendFormat": "",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "statsRange",
          "maxLines": 200
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Access log outcomes",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"dumbwaiter\",environment=\"local\"} _msg:=\"request\" | stats by (outcome) rate()",
          "legendFormat": "",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "statsRange",
          "maxLines": 200
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Errors / warnings / failed transfers",
      "description": "Access lines are INFO even on HTTP errors. Filter by status/outcome rather than level alone.",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"dumbwaiter\",environment=\"local\"} (level:in(\"ERROR\", \"WARN\") OR outcome:in(\"aborted\", \"write_error\", \"panic\"))",
          "legendFormat": "",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 4,
      "title": "HTTP errors (including INFO access lines)",
      "description": "",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"dumbwaiter\",environment=\"local\"} _msg:=\"request\" status:~\"^[45]\"",
          "legendFormat": "",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "gridPos": {
