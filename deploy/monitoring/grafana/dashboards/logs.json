    {
      "id": 6,
      "title": "Vector read vs delivered",
      "description": "Different windows/batching can briefly diverge; not a durable exactly-once audit trail.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vector_component_received_events_total{job=\"vector\",component_id=\"dumbwaiter\"}[$__rate_interval]))",
          "legendFormat": "read",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "sum(rate(vector_component_sent_events_total{job=\"vector\",component_id=\"victorialogs\"}[$__rate_interval]))",
          "legendFormat": "delivered",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
