    {
      "id": 7,
      "title": "GC pause p99",
      "description": "Uses histogram, not an average of per-process summary quantiles. No GC events => no quantile.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le,instance)(rate(go_gc_pauses_seconds_bucket{job=\"dumbwaiter\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
