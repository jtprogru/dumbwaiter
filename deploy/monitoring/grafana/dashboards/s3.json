{
  "uid": "dumbwaiter-s3",
  "title": "dumbwaiter · S3 dependency",
  "description": "A request may perform multiple S3 lookups. S3 timing stops at headers, not at body completion.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "dumbwaiter"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "title": "dumbwaiter",
      "type": "dashboards",
      "tags": [
        "dumbwaiter"
      ],
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(up{job=\"dumbwaiter\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"dumbwaiter\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "bucket",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(dumbwaiter_s3_requests_total{job=\"dumbwaiter\",instance=~\"$instance\"}, bucket)",
          "refId": "bucket"
        },
        "definition": "label_values(dumbwaiter_s3_requests_total{job=\"dumbwaiter\",instance=~\"$instance\"}, bucket)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "S3 traffic",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (bucket,method,code)(rate(dumbwaiter_s3_requests_total{job=\"dumbwaiter\",instance=~\"$instance\",bucket=~\"$bucket\"}[$__rate_interval]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "S3 failures: 5xx / transport / timeout",
      "description": "Denominator includes all S3 attempts including client cancellations; this is diagnostic, not an SLO.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (bucket)(rate(dumbwaiter_s3_requests_total{job=\"dumbwaiter\",instance=~\"$instance\",bucket=~\"$bucket\",code=~\"5..|error|timeout\"}[$__rate_interval]))) or (0 * sum by (bucket)(rate(dumbwaiter_s3_requests_total{job=\"dumbwaiter\",instance=~\"$instance\",bucket=~\"$bucket\"}[$__rate_interval])))) / (sum by (bucket)(rate(dumbwaiter_s3_requests_total{job=\"dumbwaiter\",instance=~\"$instance\",bucket=~\"$bucket\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
