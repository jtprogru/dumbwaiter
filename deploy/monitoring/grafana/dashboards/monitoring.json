{
  "uid": "dumbwaiter-monitoring",
  "title": "dumbwaiter · Monitoring health",
  "description": "Monitoring must monitor itself. No data is not green. Persistent queues are bounded; 7-day retention is not a disk size cap.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "dumbwaiter"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "title": "dumbwaiter",
      "type": "dashboards",
      "tags": [
        "dumbwaiter"
      ],
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
