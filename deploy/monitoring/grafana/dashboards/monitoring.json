    {
      "id": 6,
      "title": "Vector pipeline errors / drops",
      "description": "Counters may be absent before first event. Check scrape health.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component_id,error_type)(rate(vector_component_errors_total{job=\"vector\"}[$__rate_interval]))",
