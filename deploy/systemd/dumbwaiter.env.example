# /etc/dumbwaiter/dumbwaiter.env, mode 0600 root:root.
# Values for ${S3_ACCESS_KEY_ID} and ${S3_SECRET_ACCESS_KEY} in config.yaml.
#
# Commented out on purpose: an empty value would mean anonymous access to S3
# and a stream of 403s, while an unset variable stops the start with a clear
# error. Uncomment and fill both.
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
