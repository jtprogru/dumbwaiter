{{/* Chart name, cut to the 63-character DNS label limit. */}}
{{- define "dumbwaiter.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/* Fully qualified app name, also cut to 63 characters. */}}
{{- define "dumbwaiter.fullname" -}}
{{- if .Values.fullnameOverride }}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- $name := default .Chart.Name .Values.nameOverride }}
{{- if contains $name .Release.Name }}
{{- .Release.Name | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
{{- end }}
{{- end }}
{{- end }}

{{/* fullname with a suffix, still a valid DNS label. */}}
{{- define "dumbwaiter.suffixedName" -}}
{{- printf "%s-%s" (include "dumbwaiter.fullname" .root) .suffix | trunc 63 | trimSuffix "-" }}
{{- end }}

{{- define "dumbwaiter.labels" -}}
helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{ include "dumbwaiter.selectorLabels" . }}
app.kubernetes.io/version: {{ .Values.image.tag | default .Chart.AppVersion | trunc 63 | quote }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- end }}

{{- define "dumbwaiter.selectorLabels" -}}
app.kubernetes.io/name: {{ include "dumbwaiter.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end }}

{{- define "dumbwaiter.image" -}}
{{- if .Values.image.digest }}
{{- printf "%s@%s" .Values.image.repository .Values.image.digest }}
{{- else }}
{{- printf "%s:%s" .Values.image.repository (.Values.image.tag | default .Chart.AppVersion) }}
{{- end }}
{{- end }}

{{/* Secret with the S3 keys: the existing one, the one the chart creates, or none. */}}
{{- define "dumbwaiter.s3SecretName" -}}
{{- if .Values.s3.existingSecret }}
{{- .Values.s3.existingSecret }}
{{- else if or .Values.s3.accessKeyId .Values.s3.secretAccessKey }}
{{- include "dumbwaiter.suffixedName" (dict "root" . "suffix" "s3") }}
{{- end }}
{{- end }}

{{/* Every host from config.sites as a JSON list, for HTTPRoute, Ingress and Certificate defaults. */}}
{{- define "dumbwaiter.hosts" -}}
{{- $hosts := list }}
{{- range .Values.config.sites }}
{{- range .hosts }}
{{- $hosts = append $hosts (lower .) }}
{{- end }}
{{- end }}
{{- toJson (uniq $hosts) }}
{{- end }}

{{/*
The proxy config.yaml: values.config plus the listener settings the chart
owns. The ports in the pod spec and Services come from the same values, so
they cannot drift apart.
*/}}
{{- define "dumbwaiter.config" -}}
{{- $cfg := deepCopy (.Values.config | default dict) }}
{{- if not $cfg.sites }}
{{- fail "config.sites: at least one site is required" }}
{{- end }}
{{- $server := $cfg.server | default dict }}
{{- if hasKey $server "https" }}
{{- fail "config.server.https is generated by the chart, configure TLS with the tls.* values" }}
{{- end }}
{{- $http := $server.http | default dict }}
{{- $_ := set $http "addr" (printf ":%d" (int .Values.containerPorts.http)) }}
{{- $admin := $server.admin | default dict }}
{{- $_ := set $admin "addr" (printf ":%d" (int .Values.containerPorts.admin)) }}
{{- if .Values.tls.enabled }}
{{- if and .Values.tls.redirectToHTTPS (or .Values.ingress.enabled .Values.httpRoute.enabled) }}
{{- fail "tls.redirectToHTTPS with ingress or httpRoute is a redirect loop: the edge sends plain HTTP and gets a 301 back. Set tls.redirectToHTTPS=false" }}
{{- end }}
{{- if not .Values.tls.certificates }}
{{- fail "tls.certificates: at least one certificate is required when tls.enabled" }}
{{- end }}
{{- $certs := list }}
{{- range .Values.tls.certificates }}
{{- if not (regexMatch "^[a-z0-9]([-a-z0-9]{0,57}[a-z0-9])?$" (.name | default "")) }}
{{- fail (printf "tls.certificates: name %q must be a DNS label of at most 59 characters" (.name | default "")) }}
{{- end }}
{{- $_ := required (printf "tls.certificates[%s].secretName is required" .name) .secretName }}
{{- $certs = append $certs (dict "cert" (printf "/etc/tls/%s/tls.crt" .name) "key" (printf "/etc/tls/%s/tls.key" .name)) }}
{{- end }}
{{- $_ := set $http "redirect_to_https" .Values.tls.redirectToHTTPS }}
{{- $_ := set $server "https" (dict
    "addr" (printf ":%d" (int .Values.containerPorts.https))
    "public_port" (int .Values.tls.service.httpsPort)
    "http3" .Values.tls.http3
    "reload_interval" .Values.tls.reloadInterval
    "certificates" $certs) }}
{{- end }}
{{- $_ := set $server "http" $http }}
{{- $_ := set $server "admin" $admin }}
{{- $_ := set $cfg "server" $server }}
{{- toYaml $cfg }}
{{- end }}

{{/* Spec fields shared by the public TCP and UDP Services. */}}
{{- define "dumbwaiter.publicServiceSpec" -}}
{{- $svc := .Values.tls.service -}}
type: {{ $svc.type }}
{{- if has $svc.type (list "LoadBalancer" "NodePort") }}
externalTrafficPolicy: {{ $svc.externalTrafficPolicy }}
{{- end }}
{{- if eq $svc.type "LoadBalancer" }}
{{- with $svc.loadBalancerClass }}
loadBalancerClass: {{ . }}
{{- end }}
{{- with $svc.loadBalancerSourceRanges }}
loadBalancerSourceRanges:
  {{- toYaml . | nindent 2 }}
{{- end }}
{{- end }}
selector:
  {{- include "dumbwaiter.selectorLabels" . | nindent 2 }}
{{- end }}
