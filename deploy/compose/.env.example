# Copy to .env next to compose.yaml, Docker Compose reads it on every command.
# Keep it out of git: it holds the S3 keys.

# Which setup to run: compose.yaml (Caddy terminates TLS) or compose.tls.yaml
# (TLS in dumbwaiter). Saves typing -f on every command.
#COMPOSE_FILE=compose.tls.yaml

# Image tag: a release or the result of make docker-build.
DUMBWAITER_TAG=v0.1.0

# Domains Caddy gets certificates for, comma-separated. The same hosts as in
# config.yaml. compose.tls.yaml does not use it.
SITE_DOMAINS=example.com, www.example.com

# Values for ${S3_ACCESS_KEY_ID} and ${S3_SECRET_ACCESS_KEY} in config.yaml.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
